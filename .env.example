# Configuración del Servidor knoMap (.env)
# Copia este archivo a `.env` en tu servidor y reemplaza los valores de producción.
# El archivo `.env` NO se subirá a GitHub gracias a `.gitignore`.

ADMIN_PASSWORD=tu_contrasena_de_administrador_aqui
JWT_SECRET=tu_clave_secreta_jwt_de_produccion_aqui_123456789

# Configuración de LLM
LLM_BASE_URL=http://172.17.0.1:1234/v1
LLM_API_KEY=
LLM_MODEL=default
